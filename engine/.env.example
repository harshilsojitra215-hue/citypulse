# Copy to .env (never commit .env). Every value has a working default; set only what differs on your machine.

# Where the data bundle lives (built by pipeline/30_build_app_data.py, or received as app_data.zip)
CITYPULSE_DATA=./app_data
# Where uploaded batches are stored
CITYPULSE_RUNS=./runs
# The fine-tuned matcher (see models/MODEL_CARD.md). Without it the app runs on cached scores and says so.
CITYPULSE_MODEL=./models/citypulse-matcher-v2
# Force a device for the matcher: cuda | mps | cpu (default: best available)
# CITYPULSE_DEVICE=cpu

# Embeddings: bge-m3 through a local Ollama (ollama pull bge-m3)
OLLAMA_URL=http://127.0.0.1:11434
CITYPULSE_EMBED_MODEL=bge-m3

# LLM that classifies new posts and extracts arguments in the batch workflow
#   claude = Claude Code CLI, logged in with a subscription (no API key is used or needed)
#   ollama = a local model served by Ollama, e.g. qwen3.8:27b-q4_K_M
CITYPULSE_LLM_BACKEND=claude
CITYPULSE_LLM_MODEL=haiku

# Salt for hashing author names on ingest. Use your own secret value in production; never publish it.
CITYPULSE_AUTHOR_SALT=change-me

# Research lab directory (only needed to rerun the research pipeline or the benchmark)
# CITYPULSE_LAB=/path/to/lab

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
